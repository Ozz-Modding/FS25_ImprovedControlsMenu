<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="ImprovedControlsFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_options"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_icm_title"/>
        </GuiElement>

        <!-- Filter status text -->
        <Text profile="icm_filterStatus" id="filterStatusText" text=""/>

        <!-- Controls header and list (same structure as base game subCategoryPages[4]) -->
        <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
            <Text profile="fs25_settingsControlsListHeaderTitle" text="$l10n_icm_actionHeader"/>
            <Button profile="fs25_settingsControlsListHeaderButtonPrev" id="buttonPrevRow" position="450px 10px" onClick="onClickPrevRow"/>
            <Text profile="fs25_settingsControlsListHeaderName" id="headerText1" position="485px 10px" text="$l10n_ui_key1"/>
            <Text profile="fs25_settingsControlsListHeaderName" id="headerText2" position="785px 10px" text="$l10n_ui_key2"/>
            <Text profile="fs25_settingsControlsListHeaderName" id="headerText3" position="1085px 10px" text="$l10n_ui_mouse"/>
            <Button profile="fs25_settingsControlsListHeaderButtonNext" id="buttonNextRow" position="1400px 10px" onClick="onClickNextRow"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottomSoft" absoluteSizeOffset="-60px 0px" position="-10px 0px"/>
        </GuiElement>
        <SmoothList profile="fs25_settingsControlsList" id="controlsList" absoluteSizeOffset="90px 60px" listSectionHeader="section" bottomClipperElement="bottomClipper">
            <ListItem profile="fs25_settingsControlsListItem">
                <ThreePartBitmap profile="fs25_settingsControlsListItemBg" name="alternating"/>
                <Text profile="fs25_settingsControlsListName" name="actionName"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="485px 0px"/>
                <Button profile="fs25_settingsControlsListButton" name="actionButton1" position="490px 0px" onClick="onMenuAcceptUp">
                    <ThreePartBitmap profile="fs25_settingsControlsListButtonBg"/>
                </Button>
                <Bitmap profile="fs25_settingsControlsSeparator" position="785px 0px"/>
                <Button profile="fs25_settingsControlsListButton" name="actionButton2" position="790px 0px" onClick="onMenuAcceptUp">
                    <ThreePartBitmap profile="fs25_settingsControlsListButtonBg"/>
                </Button>
                <Bitmap profile="fs25_settingsControlsSeparator" position="1085px 0px"/>
                <Button profile="fs25_settingsControlsListButton" name="actionButton3" position="1090px 0px" onClick="onMenuAcceptUp">
                    <ThreePartBitmap profile="fs25_settingsControlsListButtonBg"/>
                </Button>
                <Bitmap profile="fs25_settingsControlsSeparator" position="1385px 0px"/>
            </ListItem>
            <ListItem profile="fs25_settingsControlsListSection" name="section">
                <Text profile="fs25_settingsControlsListSectionTitle" name="title"/>
            </ListItem>
        </SmoothList>
        <Bitmap profile="fs25_stopClipper" name="bottomClipper"/>
    </GuiElement>

    <GUIProfiles>
        <Profile name="icm_filterStatus" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="1200px 30px"/>
            <position value="50px 10px"/>
            <textAlignment value="left"/>
            <textSize value="16px"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>

    </GUIProfiles>
</GUI>
